<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GstFitGenerator.App.ViewModels"
             xmlns:c="using:GstFitGenerator.App.Controls"
             xmlns:l="using:GstFitGenerator.App"
             x:Class="GstFitGenerator.App.Views.TechScreensView"
             x:DataType="vm:TechScreensViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20" Spacing="14">
            <TextBlock Classes="h1" Text="{l:T 'Pantallas de techs'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{l:T 'Pantallas de trazabilidad del HMI con un faceplate TechLayout por feature: un recuadro por Fixture y una columna por Asset. Cada referencia ocupa pantallas desde su pantalla de inicio; si no cabe, la siguiente se corre. Las reservas solo salen si tienen pantalla de inicio.'}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Classes="card" Padding="0" VerticalAlignment="Top" MinWidth="320">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="tablehead">
                            <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
                                <TextBlock Classes="columnHeader" Text="{l:T 'CONTENIDO'}" />
                                <TextBlock Grid.Column="1" Classes="columnHeader" Text="{l:T 'EMPIEZA EN'}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Starts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TechStartRowViewModel">
                                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="14,6">
                                        <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="0" VerticalAlignment="Top" MaxHeight="320">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="tablehead">
                            <Grid ColumnDefinitions="80,*,*" ColumnSpacing="10">
                                <TextBlock Classes="columnHeader" Text="{l:T 'TIPO'}" />
                                <TextBlock Grid.Column="1" Classes="columnHeader" Text="{l:T 'NOMBRE'}" />
                                <TextBlock Grid.Column="2" Classes="columnHeader" Text="{l:T 'NOMBRE CORTO'}" />
                            </Grid>
                        </Border>
                        <ListBox Classes="table" ItemsSource="{Binding ShortNames}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortNameRowViewModel">
                                    <Grid ColumnDefinitions="80,*,*" ColumnSpacing="10">
                                        <TextBlock Classes="label" Text="{Binding Kind}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBox Grid.Column="2" Classes="cell mono" Text="{Binding ShortName, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Plegado por defecto, para que la vista previa quede a mano -->
            <Border Classes="card" Padding="4">
                <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Classes="caption" Text="{l:T 'ESTILO Y LIENZO'}" VerticalAlignment="Center" />
                    </Expander.Header>
                <StackPanel Spacing="10">
                    <Button Command="{Binding ResetStyleCommand}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="undo" />
                            <TextBlock Text="{l:T 'Restaurar estilo por defecto'}" />
                        </StackPanel>
                    </Button>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="18" LineSpacing="10">
                        <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="18" LineSpacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StyleColorViewModel">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="{Binding Label}" />
                                        <ColorPicker Color="{Binding Color}" IsAlphaEnabled="False" IsAlphaVisible="False" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Letra del título'}" />
                            <NumericUpDown Value="{Binding TitleFontSize}" Minimum="{Binding MinFontSize}" Maximum="{Binding MaxFontSize}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Letra de las filas'}" />
                            <NumericUpDown Value="{Binding LabelFontSize}" Minimum="{Binding MinFontSize}" Maximum="{Binding MaxFontSize}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Alto de fila'}" />
                            <NumericUpDown Value="{Binding RowHeight}" Minimum="{Binding MinRowHeight}" Maximum="{Binding MaxRowHeight}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Separación entre recuadros'}" />
                            <NumericUpDown Value="{Binding BoxGap}" Minimum="0" Maximum="{Binding MaxBoxGap}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{Binding FaceplateSize, StringFormat='Faceplate ({0})'}" />
                            <NumericUpDown Value="{Binding FaceplateWidth}" Minimum="{Binding MinFaceplateWidth}" Maximum="{Binding MaxFaceplateWidth}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Classes="label" Text="{l:T 'Lienzo: márgenes de la zona donde van los recuadros (píxeles de la pantalla de 1920 × 966)'}" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="18" LineSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Izquierda'}" />
                            <NumericUpDown Value="{Binding MarginLeft}" Minimum="0" Maximum="{Binding MaxMargin}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Arriba'}" />
                            <NumericUpDown Value="{Binding MarginTop}" Minimum="0" Maximum="{Binding MaxMargin}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Derecha'}" />
                            <NumericUpDown Value="{Binding MarginRight}" Minimum="0" Maximum="{Binding MaxMargin}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Abajo'}" />
                            <NumericUpDown Value="{Binding MarginBottom}" Minimum="0" Maximum="{Binding MaxMargin}" Increment="1" FormatString="0" Width="110" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                </Expander>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasErrors}">
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                                <c:Icon Kind="alert" Width="14" Height="14" Foreground="{DynamicResource App.Bad}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Classes="card" IsVisible="{Binding HasWarnings}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                                <c:Icon Kind="alert" Width="14" Height="14" Foreground="{DynamicResource App.Warn}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !HasPages}"
                       Text="{l:T 'Elige la pantalla de inicio de alguna referencia para ver la vista previa.'}" />
            <StackPanel Spacing="8" IsVisible="{Binding HasPages}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="label" Text="{l:T 'Vista previa'}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" MinWidth="420" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TechPageOption">
                                <TextBlock Classes="mono" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Command="{Binding ResetAllBoxesCommand}" ToolTip.Tip="{l:T 'Quita todos los retoques: los recuadros vuelven a colocarse solos'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="undo" />
                            <TextBlock Text="{l:T 'Recolocar todo automáticamente'}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T 'Pulsa un recuadro para elegirlo y arrástralo para moverlo. Lo que no toques se sigue colocando solo.'}" />

                <Border Classes="card" IsVisible="{Binding HasSelectedBox}">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="18" LineSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Recuadro'}" />
                            <TextBlock Classes="mono" Text="{Binding SelectedBoxTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Pantalla'}" />
                            <ComboBox ItemsSource="{Binding BoxScreenOptions}" SelectedIndex="{Binding BoxScreenIndex}" Width="140" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="X" />
                            <NumericUpDown Value="{Binding BoxLeft}" Minimum="0" Maximum="1920" Increment="8" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Y" />
                            <NumericUpDown Value="{Binding BoxTop}" Minimum="0" Maximum="966" Increment="8" FormatString="0" Width="110" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Filas por columna'}" />
                            <NumericUpDown Value="{Binding BoxRows}" Minimum="1" Maximum="40" Increment="1" FormatString="0" Width="110"
                                           PlaceholderText="{Binding BoxRowsHint, StringFormat='auto ({0})'}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding CanSplit}">
                            <TextBlock Classes="label" Text="{l:T 'Partir antes de'}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox ItemsSource="{Binding SplitOptions}" SelectedItem="{Binding SplitAsset}" Width="140" />
                                <Button Command="{Binding SplitCommand}" Content="{l:T 'Partir'}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text=" " />
                            <Button Command="{Binding ResetBoxCommand}" ToolTip.Tip="{l:T 'Quita los retoques de este recuadro (y sus partes)'}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Kind="undo" />
                                    <TextBlock Text="{l:T 'Colocación automática'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Viewbox Stretch="Uniform">
                        <c:TechScreenPreview x:Name="Preview" Page="{Binding SelectedPage.Page, FallbackValue={x:Null}}" Title="{Binding SelectedPage.Text, FallbackValue=''}"
                                             SelectedBox="{Binding SelectedBox}" />
                    </Viewbox>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
