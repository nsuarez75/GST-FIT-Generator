<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GstFitGenerator.App.ViewModels"
             xmlns:c="using:GstFitGenerator.App.Controls"
             xmlns:l="using:GstFitGenerator.App"
             x:Class="GstFitGenerator.App.Views.VersionsView"
             x:DataType="vm:VersionsViewModel">
    <DockPanel Margin="24,20">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
            <TextBlock Classes="h1" Text="{l:T 'Control de versiones'}" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
                <Button Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="plus" />
                        <TextBlock Text="{l:T 'Añadir'}" />
                    </StackPanel>
                </Button>
                <Button Classes="danger" Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="trash" />
                        <TextBlock Text="{l:T 'Eliminar'}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="{l:T 'Lista de cambios del proyecto; sale en la hoja Control Versiones de la plantilla. Al generar, si algo ha cambiado de posición, la app propone añadir una entrada.'}" />

        <Border Classes="card" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="tablehead">
                    <Grid ColumnDefinitions="130,*" ColumnSpacing="10">
                        <TextBlock Classes="columnHeader" Text="{l:T 'FECHA'}" />
                        <TextBlock Grid.Column="1" Classes="columnHeader" Text="{l:T 'DESCRIPCIÓN'}" />
                    </Grid>
                </Border>
                <ListBox Classes="table" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionRowViewModel">
                            <Grid ColumnDefinitions="130,*" ColumnSpacing="10">
                                <TextBox Classes="cell mono" Text="{Binding Date, UpdateSourceTrigger=LostFocus}" />
                                <TextBox Grid.Column="1" Classes="cell" Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
